---
const nodes = [
  "Architecture",
  "AI Coding",
  "Agents",
  "Governance",
  "MCP",
  "CI/CD",
  "Security",
  "Traceability",
];
---

<div class="signal-map" aria-label="Technical focus map">
  <div class="signal-map__grid"></div>
  <svg class="signal-lines" viewBox="0 0 100 100" aria-hidden="true">
    <line x1="50" y1="50" x2="27" y2="22"></line>
    <line x1="50" y1="50" x2="78" y2="34"></line>
    <line x1="50" y1="50" x2="20" y2="51"></line>
    <line x1="50" y1="50" x2="82" y2="62"></line>
    <line x1="50" y1="50" x2="23" y2="82"></line>
    <line x1="50" y1="50" x2="80" y2="78"></line>
    <line x1="50" y1="50" x2="52" y2="17"></line>
    <line x1="50" y1="50" x2="42" y2="70"></line>
  </svg>
  <div class="signal-map__core">
    <span>JS</span>
  </div>
  {nodes.map((node, index) => <span class={`signal-node signal-node--${index + 1}`}>{node}</span>)}
</div>
